{
  "$schema": "https://railway.app/railway.schema.json",
  "services": [
    {
      "name": "laravel-backend",
      "source": {
        "type": "path",
        "path": "backend"
      },
      "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_URL": "https://{{ .laravel-backend.RAILWAY_PUBLIC_DOMAIN }}",
        "APP_KEY": "{{ .APP_KEY }}",
        "DB_CONNECTION": "pgsql",
        "DB_HOST": "{{ .postgres.RAILWAY_PRIVATE_DOMAIN }}",
        "DB_PORT": "5432",
        "DB_DATABASE": "{{ .postgres.DATABASE }}",
        "DB_USERNAME": "{{ .postgres.USER }}",
        "DB_PASSWORD": "{{ .postgres.PASSWORD }}",
        "REDIS_HOST": "{{ .redis.RAILWAY_PRIVATE_DOMAIN }}",
        "REDIS_PORT": "6379",
        "AI_SERVICE_URL": "http://{{ .ai-service.RAILWAY_PRIVATE_DOMAIN }}:7777",
        "API_SECRET_KEY": "{{ .API_SECRET_KEY }}"
      }
    },
    {
      "name": "ai-service",
      "source": {
        "type": "path",
        "path": "ai-service"
      },
      "env": {
        "API_SECRET_KEY": "{{ .API_SECRET_KEY }}",
        "MSE_AI_API_URL": "http://localhost:7777"
      }
    },
    {
      "name": "frontend-pwa",
      "source": {
        "type": "path",
        "path": "frontend"
      },
      "env": {
        "VITE_API_URL": "https://{{ .laravel-backend.RAILWAY_PUBLIC_DOMAIN }}/api/v1"
      }
    },
    {
      "type": "postgresql",
      "name": "postgres"
    },
    {
      "type": "redis",
      "name": "redis"
    }
  ]
}
